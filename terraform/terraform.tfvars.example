# ==============================================================================
# HoneyTrap - Example Configuration Variables
# Rename this file to terraform.tfvars and fill in your values
# ==============================================================================

aws_region     = "us-east-1"
environment    = "production"
instance_type  = "t3.micro"
key_name       = "your-aws-ssh-key-name"
admin_ip       = "YOUR_PUBLIC_IP/32" # Replace with: curl https://checkip.amazonaws.com
admin_ssh_port = 2222
alert_email    = "your-email@example.com"
