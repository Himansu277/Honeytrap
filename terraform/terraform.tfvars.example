# ==============================================================================
# HoneyTrap - Example Configuration Variables (Single-Server Deployment)
# Copy this file to terraform.tfvars and customize with your parameters:
# cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

aws_region     = "ap-south-1"
environment    = "demo"
instance_type    = "t3.small"
root_volume_size = 25
key_name         = "your-aws-ssh-key-name"
admin_ip         = "YOUR_PUBLIC_IP/32" # Required: Find with 'curl https://checkip.amazonaws.com'
admin_ssh_port   = 2222
